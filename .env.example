# Environment variables for LLM API keys
# Copy this file to .env and fill in your API keys

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# vLLM Server (for local/Kaggle hosted models)
# Set this to your vLLM server URL (e.g., ngrok URL)
VLLM_BASE_URL=https://952c-104-198-62-111.ngrok-free.app
VLLM_API_KEY=EMPTY

# FairGame API URL (optional, for API mode)
FAIRGAME_URL=http://127.0.0.1:5003/create_and_run_games
