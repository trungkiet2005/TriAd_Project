# This file provides structured citation information for the repository

cff-version: 1.2.0
message: "If you use this software or findings, please cite our UAI 2026 paper."
title: "Project TRIAD: The Trembling, Welfare, and Heroism Paradoxes in Multi-Agent LLM Systems"
version: 1.0.0
